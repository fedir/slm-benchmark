  "setup": "CREATE TABLE employees(id INTEGER PRIMARY KEY, name TEXT, dept TEXT, salary INTEGER, manager_id INTEGER); INSERT INTO employees VALUES (1,'Kim',NULL,80000,NULL),(2,'Lee',NULL,55000,1),(3,'Max',NULL,80000,1),(4,'Ned',NULL,61000,1);",
  "expected": [
   [
    "Kim"
   ],
   [
    "Max"
   ],
   [
    "Ned"
   ]
  ],
  "ordered": true
 },
